    "# ================================================================\n",
    "# 1️⃣ PARAMETRI BASE DELLA SCALATURA  (coerenti con PD ≈ 30%)\n",
    "# ================================================================\n",
    "\n",
    "# Punteggio di riferimento (scala leggibile, centrato sul rischio medio)\n",
    "target_points_at_odds = 600     # score medio\n",
    "target_odds = 2.33              # odds reali (70% good / 30% bad)\n",
    "pdo = 20                        # Points to Double the Odds (standard)\n",
    "\n",
    "# Calcolo dei parametri di scala\n",
    "factor = pdo / np.log(2)\n",
    "offset = target_points_at_odds - factor * np.log(target_odds)\n",
    "\n",
    "print(\"=== Parametri di scalatura ===\")\n",
    "print(f\"Target odds: {target_odds:.2f} : 1\")\n",
    "print(f\"PDO (Points to Double the Odds): {pdo}\")\n",
    "print(f\"Factor: {factor:.2f}\")\n",
    "print(f\"Offset: {offset:.2f}\")\n",
    "\n",
    "# ================================================================\n",
    "# 2️⃣ COSTRUZIONE DELLA SCORECARD\n",
    "# ================================================================\n",
    "\n",
    "\n",
    "scorecard_tables = []\n",
    "\n",
    "for var in vars_keep:\n",
    "    beta = res_w.params[var]\n",
    "    bv = binning_process.get_binned_variable(var)\n",
    "    table = bv.binning_table.build()[[\"Bin\", \"WoE\"]]\n",
