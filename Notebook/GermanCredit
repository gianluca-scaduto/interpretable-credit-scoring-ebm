    "    # Escludere eventuali bin \"Special\" o \"Missing\"\n",
    "    table = table[~table[\"Bin\"].isin([\"Special\", \"Missing\"])]\n",
    "\n",
    "    # Calcolo dei punti per ciascun bin\n",
    "    table[\"Points\"] = - beta * table[\"WoE\"] * factor\n",
