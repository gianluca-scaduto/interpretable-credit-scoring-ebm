    "    max_n_prebins=20,                # più pre-bin iniziali = maggiore flessibilità\n",
    "    min_prebin_size=0.01,            # riduce la soglia minima per generare split\n",
    "                \n",
    "    max_pvalue=0.2,                  # meno restrittivo nel merging dei bin\n",
    "    min_bin_size=0.01              # dimensione minima per bin finali\n",
