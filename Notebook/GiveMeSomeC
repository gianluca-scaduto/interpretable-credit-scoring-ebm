    "# === BINNING OTTIMIZZATO PER LE VARIABILI DI CONTEGGIO ===\n",
    "from optbinning import OptimalBinning\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Variabili di conteggio che davano problemi nel binning automatico\n",
    "vars_time = [\n",
    "    \"NumberOfTime30-59DaysPastDueNotWorse\",\n",
    "    \"NumberOfTime60-89DaysPastDueNotWorse\",\n",
    "    \"NumberOfTimes90DaysLate\"\n",
    "]\n",
    "\n",
    "for var in vars_time:\n",
    "    print(\"=\" * 70)\n",
    "    print(f\" Variabile (binning manuale): {var}\")\n",
    "    print(\"=\" * 70)\n",
    "\n",
    "    # Binning personalizzato con parametri rilassati\n",
    "    bv = OptimalBinning(\n",
    "        name=var,\n",
    "        dtype=\"numerical\",\n",
    "        solver=\"cp\",\n",
    "        monotonic_trend=None,     # disattiva monotonicità\n",
    "        max_n_prebins=20,         # più granularità\n",
    "        min_prebin_size=0.01,     # consente bin piccoli\n",
    "        min_bin_size=0.01,        # idem\n",
    "        min_bin_n_nonevent=1,\n",
    "        min_bin_n_event=1,\n",
    "        verbose=False\n",
    "    )\n",
    "\n",
    "    # Fit su train\n",
    "    bv.fit(X_train_imp[var], y_train)\n",
    "\n",
    "    # Stato del binning\n",
    "    print(\"Status:\", bv.status)\n",
    "\n",
    "    # Cutpoints trovati\n",
    "    print(\"Splits:\", bv.splits)\n",
    "\n",
    "    # Tabella WoE / IV\n",
    "    table = bv.binning_table.build()\n",
    "    print(table)\n",
    "\n",
    "    # Grafico WoE\n",
    "    bv.binning_table.plot(metric=\"woe\", style=\"actual\", add_special=False, add_missing=False)\n",
    "    plt.show()\n"
   ]
  },
