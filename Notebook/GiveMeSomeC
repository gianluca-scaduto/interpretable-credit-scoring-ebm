    "#### confronto tra EBM su dataset con NA e su dataset con valori imputati\n",
    "\n",
    "from interpret.glassbox import ExplainableBoostingClassifier\n",
    "from sklearn.metrics import accuracy_score, roc_auc_score\n",
    "from sklearn.utils.class_weight import compute_sample_weight\n",
    "\n",
    "#  Calcolo pesi di bilanciamento automatici\n",
    "w_train = compute_sample_weight(class_weight=\"balanced\", y=y_train)\n",
    "\n",
    "#  EBM base – dataset con NA\n",
    "ebm_na = ExplainableBoostingClassifier(random_state=42)\n",
    "ebm_na.fit(X_train, y_train, sample_weight=w_train)\n",
    "\n",
    "y_pred_na = ebm_na.predict(X_test)\n",
    "y_proba_na = ebm_na.predict_proba(X_test)[:, 1]\n",
    "\n",
    "acc_na = accuracy_score(y_test, y_pred_na)\n",
    "auc_na = roc_auc_score(y_test, y_proba_na)\n",
    "\n",
    "print(\"=== EBM con NA ===\")\n",
    "print(f\"Accuracy: {acc_na:.4f}\")\n",
    "print(f\"AUC: {auc_na:.4f}\")\n",
    "\n",
    "#  EBM base – dataset imputato con mediana\n",
    "ebm_imp = ExplainableBoostingClassifier(random_state=42)\n",
    "ebm_imp.fit(X_train_imp, y_train, sample_weight=w_train)\n",
    "\n",
    "y_pred_imp = ebm_imp.predict(X_test_imp)\n",
    "y_proba_imp = ebm_imp.predict_proba(X_test_imp)[:, 1]\n",
    "\n",
    "acc_imp = accuracy_score(y_test, y_pred_imp)\n",
    "auc_imp = roc_auc_score(y_test, y_proba_imp)\n",
    "\n",
    "print(\"\\n=== EBM con imputazione (mediana) ===\")\n",
    "print(f\"Accuracy: {acc_imp:.4f}\")\n",
    "print(f\"AUC: {auc_imp:.4f}\")\n"
   ]
