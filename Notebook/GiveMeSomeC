    "\n",
    "rows = []\n",
    "\n",
    "for i, feat in enumerate(ebm_tuned.feature_names_in_):\n",
    "    # log-odds associato al bin dei missing\n",
    "    logodds_nan = ebm_tuned.term_scores_[i][0]\n",
    "    mask_train_nan = X_train[feat].isna()\n",
    "    mask_test_nan  = X_test[feat].isna()\n",
    "#mask serve per filtrare dai dati i missing, come conteggio (maschera boleana 1=NaN 0=valore)\n",
    "    if not mask_train_nan.any():\n",
    "        continue  # se non ci sono NaN nel train, salta\n",
    "\n",
    "    rows.append({\n",
    "        \"Variabile\": feat,\n",
    "        \"% Missing (train)\": round(mask_train_nan.mean() * 100, 2),\n",
    "        \"% Missing (test)\":  round(mask_test_nan.mean() * 100, 2),\n",
    "        \"Log-odds (Missing)\": round(logodds_nan, 4),\n",
    "        \"Tasso default (Missing %)\": round(y_train[mask_train_nan].mean() * 100, 2)\n",
    "    })\n",
    "\n",
    "df_nan_clean = (\n",
    "    pd.DataFrame(rows)\n",
    "    .sort_values(\"% Missing (train)\", ascending=False)\n",
    "    .reset_index(drop=True)\n",
